{
  "schema_version": 1,
  "name": "terminal_probability_paper_grid10",
  "description": "Paper 10x10 logarithmic alpha-q grid with five matched recommender columns.",
  "scenario_prefix": "tp",
  "rng_namespace": "terminal_probability_paper_grid10",
  "replicates": 40,
  "rates": {
    "influence": {
      "minimum": 0.001,
      "maximum": 1.0,
      "levels": 10
    },
    "rewiring": {
      "minimum": 0.001,
      "maximum": 1.0,
      "levels": 10
    }
  },
  "model": {
    "node_count": 500,
    "node_follow_count": 15,
    "confidence_radius": 0.45,
    "recommendation_count": 10,
    "post_retain_count": 0,
    "maximum_steps": 20000,
    "opinion_tolerance": 0.4,
    "score_noise_std": 0.0,
    "random_ratio": 0.0
  },
  "configurations": [
    {
      "key": "random",
      "factory": "Random",
      "steepness": 1.0
    },
    {
      "key": "opinion_random_zeta1",
      "factory": "OpinionRandom",
      "steepness": 1.0
    },
    {
      "key": "opinion_random_zeta4",
      "factory": "OpinionRandom",
      "steepness": 4.0
    },
    {
      "key": "structure_random_zeta1",
      "factory": "StructureRandom",
      "steepness": 1.0
    },
    {
      "key": "structure_random_zeta4",
      "factory": "StructureRandom",
      "steepness": 4.0
    }
  ]
}
